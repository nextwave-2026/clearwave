{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clearwave.ops.v1",
  "title": "C1 operational telemetry sample",
  "description": "A periodic gauge sample per service on the ops.telemetry topic. Not an event and carries no payment identity. Keyed by service_id.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "event_id", "sample_ts", "service_id"],
  "properties": {
    "schema":     { "const": "clearwave.ops.v1" },
    "event_id":   { "type": "string" },
    "emitted_at": { "type": "string", "format": "date-time" },
    "sample_ts":  { "type": "string", "format": "date-time", "description": "EVENT time." },

    "service_id":    { "type": "string" },
    "deployment_id": { "type": ["string", "null"], "description": "A change in this value between samples is the deployment marker W2 surfaces as operational evidence." },

    "healthy":            { "type": ["boolean", "null"] },
    "queue_depth":        { "type": ["number", "null"], "minimum": 0 },
    "queue_delay_p95_ms": { "type": ["number", "null"], "minimum": 0 },
    "cpu_pct":            { "type": ["number", "null"] },
    "error_rate":         { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "restarts_total":     { "type": ["integer", "null"], "minimum": 0 }
  }
}
