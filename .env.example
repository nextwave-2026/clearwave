# Copy to .env and paste credentials. Process environment wins over this file.
# Never commit a real credential.
# Model, store, Kafka, ports and worker knobs stay at code defaults:
# investigation/agent.py, detector/config.py, surfaces/server.py,
# surfaces/escalation.py, worker/cli.py, docker-compose.yml.

# Investigation narrative. Missing: daemon stores agent_unavailable, no model diagnosis.
OPENAI_API_KEY=

# Slack paging for high/critical. Missing: channel status not_configured, no Slack page.
CLEARWAVE_SLACK_WEBHOOK_URL=

# Phone paging. All four must be set together; any gap skips the call (fallback_dashboard).
CLEARWAVE_TWILIO_ACCOUNT_SID=
CLEARWAVE_TWILIO_AUTH_TOKEN=
CLEARWAVE_TWILIO_FROM_NUMBER=
CLEARWAVE_TWILIO_TO_NUMBER=

# Hosted TwiML Bin URL. Trial Twilio rejects inline TwiML; paid accounts can omit this.
CLEARWAVE_TWILIO_TWIML_URL=
