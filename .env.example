# OpenAI API key used by the investigation agent; never commit a real key.
OPENAI_API_KEY=
# Optional OpenAI-compatible API base URL.
OPENAI_BASE_URL=
# Model id selected from the key's reachable models; defaults to verified gpt-5.6-luna.
OPENAI_MODEL=
# Responses API reasoning effort (low, medium, or high); defaults to high.
OPENAI_REASONING_EFFORT=
# Maximum output tokens per model call; defaults to 6000.
OPENAI_MAX_OUTPUT_TOKENS=
# Wall-clock deadline per investigation in seconds; defaults to 300.
OPENAI_TIMEOUT_SECONDS=
# Run python3 -m investigation.models, then set OPENAI_MODEL to a listed id.

# --- W4 surfaces: Slack and phone escalation -------------------------------
# IMPORTANT: these are NOT read from this file. investigation/env.py loads .env
# for the OpenAI settings above only; surfaces/escalation.py reads the process
# environment directly, so export these in the shell that runs the demo.
# They are listed here so nobody has to read the source to discover they exist.
#
# Slack Incoming Webhook URL. Treat as a credential: whoever holds it can post.
CLEARWAVE_SLACK_WEBHOOK_URL=
# Optional channel override; defaults to #control-tower.
CLEARWAVE_SLACK_CHANNEL=
# Twilio account SID and auth token, from console.twilio.com.
CLEARWAVE_TWILIO_ACCOUNT_SID=
CLEARWAVE_TWILIO_AUTH_TOKEN=
# The Twilio number the call comes from, E.164 (for example +15550000001).
CLEARWAVE_TWILIO_FROM_NUMBER=
# Destination, E.164. On a trial account this must be a Verified Caller ID.
CLEARWAVE_TWILIO_TO_NUMBER=
# TwiML Bin URL (https://handler.twilio.com/twiml/EH...). REQUIRED on a trial
# account: the Calls API rejects inline TwiML with HTTP 400. The four variables
# above are enough to auto-wire the channel, so leaving this unset fails only at
# call time. See "Setting up the phone channel" in
# docs/contracts/notification-escalation.md, and verify with
# python3 scripts/check_phone_channel.py --dry-run
CLEARWAVE_TWILIO_TWIML_URL=
