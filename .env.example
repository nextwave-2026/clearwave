# Copy to .env and paste credentials only. Non-secret values below are the
# team's settled defaults; setting each one equals leaving it unset.
# Values already set in the process environment win over this file.
# Never commit a real credential.

# -----------------------------------------------------------------------------
# Required for the investigation layer
# Without OPENAI_API_KEY the agent cannot diagnose; the vertical path degrades
# to agent_unavailable and the demo continues without a model narrative.
# -----------------------------------------------------------------------------
# OpenAI API key used by the investigation agent. Secret: leave empty.
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Escalation credentials
# Absent credentials are silent, not loud: the channel records itself
# unconfigured (or falls back to the dashboard) and the demo proceeds.
# HIGH/CRITICAL incidents still appear on the dashboard either way.
# -----------------------------------------------------------------------------
# Slack Incoming Webhook. Secret: leave empty. Unset -> status not_configured.
CLEARWAVE_SLACK_WEBHOOK_URL=
# Channel name on the Block Kit payload. From surfaces.escalation
# DEFAULT_SLACK_CHANNEL; juank's live-tested channel. Equals unset.
CLEARWAVE_SLACK_CHANNEL=#control-tower

# Phone: all four Twilio credentials must be present together. The code checks
# them as a set and skips the call if any one is missing (status
# fallback_dashboard). The TwiML URL alone does nothing without them.
# All five are secrets or account-specific URLs: leave empty.
CLEARWAVE_TWILIO_ACCOUNT_SID=
CLEARWAVE_TWILIO_AUTH_TOKEN=
CLEARWAVE_TWILIO_FROM_NUMBER=
CLEARWAVE_TWILIO_TO_NUMBER=
CLEARWAVE_TWILIO_TWIML_URL=

# -----------------------------------------------------------------------------
# Optional tuning
# Pre-filled keys match investigation/agent.py and surfaces/server.py defaults.
# -----------------------------------------------------------------------------
# OpenAI-compatible API base URL. Leave empty: a blank value is stripped so
# the SDK cannot treat it as a base URL, and unset means the official endpoint.
# There is no decided alternative host.
OPENAI_BASE_URL=
# Model id from investigation.agent.DEFAULT_MODEL. Equals unset.
# To pick another, run python3 -m investigation.models and replace this id.
OPENAI_MODEL=gpt-5.6-luna
# Responses API reasoning effort from DEFAULT_REASONING_EFFORT. Equals unset.
OPENAI_REASONING_EFFORT=high
# Maximum output tokens per model call from DEFAULT_MAX_OUTPUT_TOKENS. Equals unset.
OPENAI_MAX_OUTPUT_TOKENS=6000
# Wall-clock deadline per investigation in seconds from DEFAULT_TIMEOUT_SECONDS.
# Equals unset (code default is 300.0; this integer parses to the same float).
OPENAI_TIMEOUT_SECONDS=300
# Shared SQLite store. Leave empty: detector, evidence tools, and surfaces then
# use state/clearwave.db, while investigation.vertical keeps its own fallback
# of state/vertical.db. Filling this would change the vertical path.
CLEARWAVE_DB=
# Dashboard HTTP port from surfaces.server (default 8080). Equals unset.
CLEARWAVE_SURFACES_PORT=8080
# Leave empty. Any non-empty value silences surfaces HTTP access logs; filling
# it would change behaviour. Unset: logs print.
CLEARWAVE_SURFACES_QUIET=

# -----------------------------------------------------------------------------
# Live containerised path only - leave every key in this block empty
# docker-compose.yml supplies KAFKA_BOOTSTRAP_SERVERS and SCHEMA_REGISTRY_URL
# to the worker and devspace containers. Pre-filling them in a local .env would
# let a host-side file silently override container configuration. The
# worker/INCIDENT_* keys are CLI env fallbacks; Compose does not inject them,
# and they are not needed for the offline demo path.
# -----------------------------------------------------------------------------
# Kafka bootstrap. Code default if you run the worker on the host: localhost:9092.
# Compose sets kafka:29092 inside containers. Leave empty.
KAFKA_BOOTSTRAP_SERVERS=
# Schema Registry URL for the worker producer. Host default: http://localhost:8081.
# Compose sets http://schema-registry:8081. The detector consumer does not read
# this. Leave empty.
SCHEMA_REGISTRY_URL=
# Merchant profile for python -m worker.worker. CLI default merchant-a. Leave empty.
MERCHANT_TYPE=
# Named guaranteed scenario (docs/scenarios.md). Unset: not a scenario run.
# Mutually exclusive with INCIDENT_* scope flags. Leave empty.
SCENARIO=
# C6 injection window length in seconds. CLI default 900. Leave empty.
SCENARIO_DURATION_SECONDS=
# Delay between payment attempts in seconds. CLI default 1.0. Leave empty.
EVENT_INTERVAL_SECONDS=
# Emit one ops.telemetry sample every N attempts. CLI default 5. Leave empty.
TELEMETRY_EVERY=
# Incident scope. All four unset -> fully normal traffic. Leave empty.
INCIDENT_PROVIDER=
INCIDENT_ISSUING_BANK=
INCIDENT_PAYMENT_METHOD=
INCIDENT_CARD_NETWORK=
# What a scoped incident does: decline, outage, latency, or spike. Leave empty.
INCIDENT_EFFECT=
# decline_reason on affected attempts when effect=decline. Leave empty.
INCIDENT_DECLINE_REASON=
# latency_ms on affected attempts when effect=latency. Leave empty.
INCIDENT_LATENCY_MS=
