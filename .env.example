# OpenAI API key used by the investigation agent; never commit a real key.
OPENAI_API_KEY=
# Optional OpenAI-compatible API base URL.
OPENAI_BASE_URL=
# Model id selected from the key's reachable models; defaults to verified gpt-5.6-luna.
OPENAI_MODEL=
# Responses API reasoning effort (low, medium, or high); defaults to high.
OPENAI_REASONING_EFFORT=
# Maximum output tokens per model call; defaults to 6000.
OPENAI_MAX_OUTPUT_TOKENS=
# Wall-clock deadline per investigation in seconds; defaults to 300.
OPENAI_TIMEOUT_SECONDS=
# Run python3 -m investigation.models, then set OPENAI_MODEL to a listed id.
