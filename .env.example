# Copy to .env and fill in. Leave unused keys empty. Never commit a real credential.
# Values already set in the process environment win over this file.

# -----------------------------------------------------------------------------
# Required for the investigation layer
# Without OPENAI_API_KEY the agent cannot diagnose; the vertical path degrades
# to agent_unavailable and the demo continues without a model narrative.
# -----------------------------------------------------------------------------
# OpenAI API key used by the investigation agent.
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Escalation credentials
# Absent credentials are silent, not loud: the channel records itself
# unconfigured (or falls back to the dashboard) and the demo proceeds.
# HIGH/CRITICAL incidents still appear on the dashboard either way.
# -----------------------------------------------------------------------------
# Slack Incoming Webhook. Unset -> status not_configured; payload is logged only.
CLEARWAVE_SLACK_WEBHOOK_URL=
# Channel name on the Block Kit payload. Default: #control-tower.
CLEARWAVE_SLACK_CHANNEL=

# Phone: all four Twilio credentials must be present together. The code checks
# them as a set and skips the call if any one is missing (status
# fallback_dashboard). The TwiML URL alone does nothing without them.
CLEARWAVE_TWILIO_ACCOUNT_SID=
CLEARWAVE_TWILIO_AUTH_TOKEN=
CLEARWAVE_TWILIO_FROM_NUMBER=
CLEARWAVE_TWILIO_TO_NUMBER=
# TwiML Bin URL for trial accounts (inline Twiml is rejected). Optional even
# when the four credentials are set; paid accounts can omit it.
CLEARWAVE_TWILIO_TWIML_URL=

# -----------------------------------------------------------------------------
# Optional tuning, with defaults taken from the code
# -----------------------------------------------------------------------------
# OpenAI-compatible API base URL. Unset uses the official OpenAI endpoint.
OPENAI_BASE_URL=
# Model id. Default: gpt-5.6-luna.
# Run python3 -m investigation.models, then set OPENAI_MODEL to a listed id.
OPENAI_MODEL=
# Responses API reasoning effort (low, medium, or high). Default: high.
OPENAI_REASONING_EFFORT=
# Maximum output tokens per model call. Default: 6000.
OPENAI_MAX_OUTPUT_TOKENS=
# Wall-clock deadline per investigation in seconds. Default: 300.
OPENAI_TIMEOUT_SECONDS=
# Shared SQLite store for detector, evidence tools, investigation, and surfaces.
# Default: state/clearwave.db (investigation.vertical falls back to
# state/vertical.db when this is unset).
CLEARWAVE_DB=
# Dashboard HTTP port for python3 -m surfaces. Default: 8080.
CLEARWAVE_SURFACES_PORT=
# Any non-empty value silences surfaces HTTP access logs. Unset: logs print.
CLEARWAVE_SURFACES_QUIET=

# -----------------------------------------------------------------------------
# Live containerised path only
# Do not copy this block into a local .env. docker-compose.yml already supplies
# KAFKA_BOOTSTRAP_SERVERS and SCHEMA_REGISTRY_URL to the worker and devspace
# containers. Putting the compose-internal hostnames in a host-side .env will
# break a local run. The worker/INCIDENT_* keys are env fallbacks for the
# producer CLI; Compose does not currently inject them.
# -----------------------------------------------------------------------------
# Kafka bootstrap. Code default: localhost:9092. Compose: kafka:29092.
# Read by the worker producer, incident-control consumer, inject, and
# detector consume.
KAFKA_BOOTSTRAP_SERVERS=
# Schema Registry URL for the worker producer. Code default: http://localhost:8081.
# Compose: http://schema-registry:8081. The detector consumer does not read this.
SCHEMA_REGISTRY_URL=
# Merchant profile for python -m worker.worker. Default: merchant-a.
MERCHANT_TYPE=
# Named guaranteed scenario (docs/scenarios.md). Unset: not a scenario run.
# Mutually exclusive with INCIDENT_* scope flags.
SCENARIO=
# C6 injection window length in seconds. Default: 900.
SCENARIO_DURATION_SECONDS=
# Delay between payment attempts in seconds. Default: 1.0.
EVENT_INTERVAL_SECONDS=
# Emit one ops.telemetry sample every N attempts. Default: 5. 0 disables it.
TELEMETRY_EVERY=
# Incident scope. All four unset -> fully normal traffic (no incident).
INCIDENT_PROVIDER=
INCIDENT_ISSUING_BANK=
INCIDENT_PAYMENT_METHOD=
INCIDENT_CARD_NETWORK=
# What a scoped incident does: decline, outage, latency, or spike. Default: decline.
INCIDENT_EFFECT=
# decline_reason on affected attempts when effect=decline. Default: do_not_honor.
INCIDENT_DECLINE_REASON=
# latency_ms on affected attempts when effect=latency. Default: 6000.
INCIDENT_LATENCY_MS=
