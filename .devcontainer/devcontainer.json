{
  "name": "Clearwave development",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "devspace",
  "workspaceFolder": "/workspaces/clearwave",
  "runServices": ["devspace", "kafka", "schema-registry"],
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "openai.chatgpt"
      ]
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r worker/requirements.txt"
}
